<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (MSIX). package.ps1 fills in the version and packs it around the
  app that :desktop:createDistributable builds. The Store signs it, so we don't.
  Identity and PublisherDisplayName come from Partner Center (A2N Hymnal → Product identity)
  and must match it exactly. Never change them.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Acts2Network.A2NHymnal"
    Publisher="CN=022624CC-7333-4698-8E4E-5009B8C352E1"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>A2N Hymnal</DisplayName>
    <PublisherDisplayName>Acts2 Network</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 10 1809 and later. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- Each language here needs its own Store listing, so only English until Chinese listings exist. -->
  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="A2NHymnal" Executable="A2N Hymnal.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="A2N Hymnal"
        Description="Hymns with lyrics, credits and recordings, all offline."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- A regular desktop app: the bundled Java runtime, JavaFX audio and settings in the registry. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
